[Unit]
Description=Private office chat
After=network-online.target
[Service]
DynamicUser=yes
StateDirectory=office-webui
StateDirectoryMode=0700
WorkingDirectory=/opt/office-webui
Environment=HOME=/var/lib/office-webui
Environment=FROM_INIT_PY=true
Environment=STATIC_DIR=/var/lib/office-webui/static
Environment=DATA_DIR=/var/lib/office-webui/data
Environment=USE_SLIM_DOCKER=true
Environment=CONTENT_EXTRACTION_ENGINE=external
Environment=EXTERNAL_DOCUMENT_LOADER_URL=http://127.0.0.1:18765/office-extractor
Environment=OFFLINE_MODE=true
Environment=BYPASS_EMBEDDING_AND_RETRIEVAL=true
Environment=RAG_EMBEDDING_ENGINE=openai
Environment=RAG_FULL_CONTEXT=true
Environment=RAG_FILE_MAX_SIZE=8
Environment=RAG_FILE_MAX_COUNT=3
Environment=WEBUI_AUTH=true
Environment=ENABLE_SIGNUP=false
Environment=ENABLE_OLLAMA_API=false
Environment=ENABLE_VERSION_UPDATE_CHECK=false
Environment=WEBUI_SESSION_COOKIE_SECURE=true
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=TOKENIZERS_PARALLELISM=false
EnvironmentFile=/etc/office-webui.env
ExecStart=/opt/office-webui/venv/bin/uvicorn app:app --host 127.0.0.1 --port 18765 --no-access-log
MemoryHigh=700M
MemoryMax=850M
MemorySwapMax=320M
CPUQuota=100%
Restart=on-failure
RestartSec=12
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
UMask=0077
[Install]
WantedBy=multi-user.target
