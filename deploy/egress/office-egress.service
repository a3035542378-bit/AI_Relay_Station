[Unit]
Description=Office application outbound tunnel
After=network-online.target
Wants=network-online.target
Before=office-webui.service
[Service]
User=office-egress
Group=office-egress
StateDirectory=office-egress
StateDirectoryMode=0700
Environment=HOME=/var/lib/office-egress
WorkingDirectory=/var/lib/office-egress
ExecStartPre=+/opt/office-webui/venv/bin/python /opt/office-egress/refresh.py --recover
ExecStart=/opt/office-egress/mihomo -d /var/lib/office-egress -f /opt/office-egress/config.yaml
ExecStartPost=+/opt/office-egress/routes tunnel
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077
Restart=on-failure
RestartSec=2
MemoryMax=180M
[Install]
WantedBy=multi-user.target
